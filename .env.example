# Public site
NEXT_PUBLIC_SITE_URL=https://rb.us
NEXT_PUBLIC_API_URL=

# Analytics — leave empty until IDs are issued
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional public contact channels — only set confirmed values
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CATALOGUE_URL=

# Optional V2 catalogue tables
PRODUCTS_TABLE=WholesaleProducts
CATEGORIES_TABLE=WholesaleCategories
SETTINGS_TABLE=WholesaleSettings

# Admin auth (Amazon Cognito)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_REGION=us-east-1

# AWS (server-side only — never expose to the browser)
AWS_REGION=us-east-1
LEADS_TABLE=WholesaleLeads
BANNERS_TABLE=SeasonalBanners
SES_FROM_EMAIL=
SES_NOTIFY_EMAIL=

# Optional local/dev fallback. Production must use Cognito + DynamoDB.
ADMIN_SESSION_SECRET=
